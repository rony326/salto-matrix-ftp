# ════════════════════════════════════════════════════════════════════════════════
#  Salto Access Matrix — Konfiguration
#  cp .env.example .env   →   Werte eintragen   →   docker compose up -d
# ════════════════════════════════════════════════════════════════════════════════


# ── FTP / SFTP ────────────────────────────────────────────────────────────────
FTP_HOST=192.168.1.100
FTP_PROTOCOL=ftp              # ftp | sftp
FTP_PORT=21                   # ftp: 21 | sftp: 22
FTP_USER=salto-export
FTP_PASSWORD=
FTP_REMOTE_PATH=/exports/salto
FTP_DISABLED=false            # true = kein Sync, nur lokale Daten (Debug)

# FTPS (explicit TLS):
FTP_TLS=false

# SFTP mit Private Key statt Passwort:
# SFTP_KEY_FILE=/run/secrets/sftp_key
# SFTP_HOST_KEY=accept        # accept = Host-Key nicht prüfen (nur Testumgebung)

# Sync-Intervall in Sekunden (86400 = 1× täglich)
SYNC_INTERVAL_SEC=86400

# Dateinamen der Salto-Exporte (Standard-Werte, nur anpassen wenn nötig):
FTP_FILE_PERSONS=personen.csv
FTP_FILE_DOORS=tueren.csv
FTP_FILE_GROUPS=gruppen.csv
FTP_FILE_ZONES=bereich.csv


# ── nginx ─────────────────────────────────────────────────────────────────────
NGINX_HOST=salto.example.com
NGINX_MODE=https              # https | http


# ── TLS / acme.sh (nur bei NGINX_MODE=https) ─────────────────────────────────
CERTBOT_EMAIL=admin@example.com
ACME_DNS_HOOK=dns_infomaniak  # acme.sh DNS Hook — siehe https://github.com/acmesh-official/acme.sh/wiki/dnsapi
ACME_DNS_SLEEP=30             # Sekunden warten nach TXT-Record (erhöhen bei langsamem DNS)
ACME_SERVER=letsencrypt       # letsencrypt | zerossl | buypass | letsencrypt_test

# Infomaniak:
INFOMANIAK_API_TOKEN=

# Cloudflare:
# CF_Token=
# CF_Account_ID=

# Hetzner DNS:
# HETZNER_Token=

# Route53 (AWS):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# INWX:
# INWX_User=
# INWX_Password=

# DigitalOcean:
# DO_API_KEY=

# Gandi LiveDNS:
# GANDI_LIVEDNS_KEY=

# Netcup:
# NC_Apikey=
# NC_Apipw=
# NC_CID=

# OVH:
# OVH_END=ovh-eu
# OVH_AK=
# OVH_AS=
# OVH_CK=

# Weitere Provider — Variablen direkt ergänzen, acme.sh liest sie automatisch:
# https://github.com/acmesh-official/acme.sh/wiki/dnsapi


# ── Authentifizierung (optional) ─────────────────────────────────────────────
AUTH_MODE=none                # none | oidc | forward-auth

# OIDC via Authentik (wenn AUTH_MODE=oidc):
# OIDC_ISSUER=https://auth.example.com/application/o/salto-matrix/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://salto.example.com/auth/callback
# SESSION_SECRET=             # openssl rand -hex 32
